NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Local: SQLite. Produção Render: configure DATABASE_URL com PostgreSQL.
DATABASE_PATH=backend/data/pdv.sqlite
DATABASE_URL=
DATABASE_SSL=true

# Sessão, criptografia e e-mail
SESSION_COOKIE_NAME=big_lanche_session
CSRF_COOKIE_NAME=big_lanche_csrf
SESSION_TTL_DAYS=14
BCRYPT_ROUNDS=12

# Conta admin inicial. Configure valores reais somente no Render.
ADMIN_NAME=Administrador Big Lanche
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=SenhaForte123!

ENCRYPTION_KEY=base64_32_bytes_gerada_com_node_crypto
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=senha_smtp
SMTP_FROM="Big Lanche <no-reply@seudominio.com>"
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Mercado Pago Point Orders API
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=http://localhost:3000/api/mercadopago/oauth/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TERMINAL_ID=
MERCADO_PAGO_AUTH_URL=https://auth.mercadopago.com/authorization
MERCADO_PAGO_OAUTH_TEST_TOKEN=false
MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com

# Configurações usadas apenas por rotas internas legadas/testes que criam uma Order.
# A tela principal acompanha vendas reais recebidas pelo webhook.
MERCADOPAGO_CARD_DEFAULT_TYPE=credit_card
MERCADOPAGO_DEFAULT_INSTALLMENTS=1
MERCADOPAGO_INSTALLMENTS_COST=seller
MERCADOPAGO_PRINT_ON_TERMINAL=no_ticket
MERCADOPAGO_ORDER_EXPIRATION=PT16M

# Pix/QR em Point deve ser habilitado apenas se sua conta/terminal aceitar no teste oficial.
MERCADOPAGO_ENABLE_QR=false

# Em produção mantenha true. Em testes locais sem assinatura oficial use false.
MERCADOPAGO_WEBHOOK_SIGNATURE_REQUIRED=true

# Rotas auxiliares de simulação devem ficar desligadas em produção.
ENABLE_TEST_ENDPOINTS=false
